        system {
            bindings = <
&tog 0     &tog 1          &tog 2          &tog 3            &tog 4        &tog 5                                        &kp C_PREV     &kp C_PLAY_PAUSE  &kp C_NEXT         &none               &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC
&tog 6     &tog 7          &tog 8          &tog 9            &tog 10       &tog 11                                       &mt HOME N7    &mt PIPE N8       &mt PAGE_UP N9     &mt MINUS PLUS      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&tog 12    &none           &mmv MOVE_UP    &none             &msc SCRL_UP  &msc SCRL_DOWN                                &mt KP_NUM N4  &mt PERCENT N5    &mt CARET N6       &mt SLASH ASTERISK  &kp UP_ARROW          &none
&mkp MCLK  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT   &mkp LCLK     &mkp RCLK       &none        &mt INS N0       &mt END N1     &kp N2            &mt PAGE_DOWN N3   &kp LEFT_ARROW      &kp DOWN_ARROW        &kp RIGHT_ARROW
