&kp Z          &kp Q                     &kp P                 &kp L              &kp C                &kp F                                                                                     &mt AMPERSAND SQT        &mt QUESTION DOUBLE_QUOTES  &kp O                 &kp Y                    &kp K                     &mt BACKSLASH PIPE
&kp V          &kp R                     &kp N                 &kp T              &kp S                &kp D                                                                                     &kp U                    &kp A                       &kp E                 &kp I                    &kp H                     &kp RIGHT_CONTROL
&mt GLOBE TAB  &kp X                     &kp B                 &kp M              &kp G                &kp W           &mt LEFT_PARENTHESIS LEFT_BRACKET    &mt RIGHT_PARENTHESIS RIGHT_BRACKET  &mt DOUBLE_QUOTES COMMA  &mt SQT PERIOD              &mt UNDERSCORE MINUS  &kp SLASH                &kp J                     &kp CAPS
                                                               &kp LEFT_COMMAND   &mo 15               &mo 14          &kp SPACE                            &kp RSHFT                            &kp BSPC                 &mt RIGHT_ALT RET           &kp RIGHT_COMMAND
            >;

            label = "X1";
        };

        hs-indeks.en.ergodox {
            display-name = "Indks";
            bindings = <
&kp ESC        &mt EXCLAMATION NUMBER_1  &mt AT_SIGN NUMBER_2  &mt HASH NUMBER_3  &mt DOLLAR NUMBER_4  &mt PERCENT NUMBER_5                                                                            &mt LCTRL NUMBER_6  &mt AMPERSAND NUMBER_7  &mt ASTERISK NUMBER_8  &mt LEFT_PARENTHESIS NUMBER_9  &mt RIGHT_PARENTHESIS NUMBER_0  &mt PLUS EQUAL
&kp J          &kp Q                     &kp P                 &kp L              &kp C                &kp G                                                                                           &kp DOUBLE_QUOTES   &kp U                   &kp O                  &mt UNDERSCORE MINUS           &mt COLON SEMICOLON             &mt BACKSLASH PIPE
&kp Z          &kp R                     &kp N                 &kp T              &kp S                &kp F                                                                                           &kp Y               &kp H                   &kp E                  &kp I                          &kp A                           &kp RIGHT_CONTROL
&mt GLOBE TAB  &kp X                     &kp B                 &kp M              &kp D                &kp W                 &mt LEFT_PARENTHESIS LEFT_BRACKET    &mt RIGHT_PARENTHESIS RIGHT_BRACKET  &kp SQT             &kp K                   &mt LESS_THAN COMMA    &mt GREATER_THAN COMMA         &mt QUESTION SLASH              &kp CAPS
                                                               &kp LEFT_COMMAND   &mo 15               &mo 14                &kp SPACE                            &kp RIGHT_SHIFT                      &kp BACKSPACE       &mt RIGHT_ALT RET       &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            label = "Indeks";
        };
    };
};
