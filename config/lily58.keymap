        Workman_1Hand {
            display-name = "Wkmn1";
            bindings = <
&mt PLUS EQUAL       &mt RIGHT_PARENTHESIS N0  &mt LEFT_PARENTHESIS N9  &mt ASTERISK N8      &mt AMPERSAND N7  &mt CARET NUMBER_6                                                                            &mt LCTRL NUMBER_6  &mt AMPERSAND NUMBER_7  &mt ASTERISK NUMBER_8  &mt LEFT_PARENTHESIS NUMBER_9  &mt RIGHT_PARENTHESIS NUMBER_0  &mt PLUS EQUAL
&mt AMPERSAND HASH   &mt UNDERSCORE MINUS      &kp P                    &kp U                &kp F             &kp J                                                                                         &kp J               &kp F                   &kp U                  &kp P                          &mt UNDERSCORE MINUS            &mt AMPERSAND HASH
&mt COLON SEMICOLON  &kp I                     &kp O                    &kp E                &kp N             &kp A                                                                                         &kp A               &kp N                   &kp E                  &kp O                          &kp I                           &mt COLON SEMICOLON
&kp LEFT_SHIFT       &mt QUESTION SLASH        &mt GREATER_THAN PERIOD  &mt LESS_THAN COMMA  &kp L             &kp K               &mt LEFT_PARENTHESIS LEFT_BRACKET    &mt RIGHT_PARENTHESIS RIGHT_BRACKET  &kp K               &kp L                   &mt LESS_THAN COMMA    &mt GREATER_THAN PERIOD        &mt QUESTION SLASH              &kp RIGHT_SHIFT
                                                                        &kp RET              &kp BACKSPACE     &kp SPACE           &mo 13                               &mo 13                               &kp SPACE           &kp BACKSPACE           &kp RETURN
            >;

