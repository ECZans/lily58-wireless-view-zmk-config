#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC           &kp N1  &kp N2  &kp N3            &kp N4  &kp N5                                                                                &kp N6         &kp N7  &kp N8     &kp N9   &kp N0     &kp GRAVE
&kp LEFT_ALT      &kp Q   &kp D   &kp R             &kp W   &kp B                                                                                 &kp J          &kp F   &kp U      &kp P    &kp TAB    &kp RIGHT_CONTROL
&kp SINGLE_QUOTE  &kp A   &kp S   &kp H             &kp T   &kp G                                                                                 &kp Y          &kp N   &kp E      &kp O    &kp I      &kp SLASH
&lt 1 SEMICOLON   &kp Z   &kp X   &kp M             &kp C   &kp V       &mt LEFT_PARENTHESIS LEFT_BRACKET    &mt RIGHT_PARENTHESIS RIGHT_BRACKET  &kp K          &kp L   &kp COMMA  &kp DOT  &kp MINUS  &mo 2
                                  &kp LEFT_COMMAND  &tog 2  &kp RETURN  &kp SPACE                            &kp RIGHT_SHIFT                      &kp BACKSPACE  &tog 1  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&kp F1  &kp F2         &kp F3        &kp F4        &kp F5        &kp F6                                                                                    &kp F7         &kp F8         &kp F9        &kp F10   &kp F11   &kp F12
&trans  &kp NUMBER_1   &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                                                                                    &kp NUMBER_6   &kp N7         &kp N8        &kp N9    &kp N0    &trans
&trans  &kp EXCL       &kp AT        &kp HASH      &kp DOLLAR    &kp PRCNT                                                                                 &kp CARET      &kp AMPERSAND  &kp ASTERISK  &kp LPAR  &kp RPAR  &trans
&trans  &kp BACKSLASH  &kp GRAVE     &kp MINUS     &kp EQUAL     &kp UNDERSCORE  &mt LEFT_BRACKET LEFT_PARENTHESIS    &mt RIGHT_BRACKET RIGHT_PARENTHESIS  &kp SEMICOLON  &kp SLASH      &trans        &trans    &trans    &trans
                                     &trans        &none         &trans          &trans                               &trans                               &trans         &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &none        &none           &none           &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC                          &kp C_VOL_DN   &kp C_VOLUME_UP  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT   &none
&trans  &none        &none           &mmv MOVE_UP    &none                 &none                                         &kp K_MUTE     &none            &kp UP      &none             &none        &trans
&none   &none        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT       &msc SCRL_UP                                  &kp PAGE_UP    &kp LEFT         &kp DOWN    &kp RIGHT         &none        &none
&none   &bootloader  &none           &none           &none                 &msc SCRL_DOWN        &trans       &trans     &kp PAGE_DOWN  &none            &none       &none             &bootloader  &trans
                                     &trans          &trans                &trans                &mkp LCLK    &mkp RCLK  &mkp MCLK      &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
