        Workman_1.1Hand {
            display-name = "Wkmn2";
            bindings = <
&mt ESC TAB           &mt EXCLAMATION NUMBER_1  &mt AT_SIGN NUMBER_2  &mt HASH NUMBER_3  &mt DOLLAR NUMBER_4  &mt PERCENT NUMBER_5                                                                        &mt PERCENT N5     &mt DOLLAR NUMBER_4  &mt HASH NUMBER_3  &mt AT_SIGN NUMBER_2  &mt EXCLAMATION NUMBER_1  &mt ESC TAB
&mt AT_SIGN ASTERISK  &kp Q                     &kp D                 &kp R              &kp W                &kp B                                                                                       &kp B              &kp W                &kp R              &kp D                 &kp Q                     &mt AT_SIGN ASTERISK
&mt DOLLAR PERCENT    &kp Y                     &kp S                 &kp H              &kp T                &kp G                                                                                       &kp G              &kp T                &kp H              &kp S                 &kp Y                     &mt DOLLAR PERCENT
&trans                &kp Z                     &kp X                 &kp M              &kp C                &kp V                 &mt LEFT_BRACE LEFT_PARENTHESIS    &mt RIGHT_BRACE RIGHT_PARENTHESIS  &kp V              &kp C                &kp M              &kp X                 &kp Z                     &trans
