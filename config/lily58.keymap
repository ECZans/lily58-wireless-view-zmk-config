#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        workman {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC       &kp N1  &kp N2  &kp N3            &kp N4  &kp N5                                                                                &kp N6         &kp N7  &kp N8     &kp N9   &kp N0     &kp GRAVE
&kp LEFT_ALT  &kp Q   &kp D   &kp R             &kp W   &kp B                                                                                 &kp J          &kp F   &kp U      &kp P    &kp TAB    &kp RIGHT_CONTROL
&kp SQT       &kp A   &kp S   &kp H             &kp T   &kp G                                                                                 &kp Y          &kp N   &kp E      &kp O    &kp I      &kp SEMICOLON
&kp MINUS     &kp Z   &kp X   &kp M             &kp C   &kp V       &mt LEFT_PARENTHESIS LEFT_BRACKET    &mt RIGHT_PARENTHESIS RIGHT_BRACKET  &kp K          &kp L   &kp COMMA  &kp DOT  &kp SLASH  &mo 3
                              &kp LEFT_COMMAND  &mo 3   &kp RETURN  &kp SPACE                            &kp RIGHT_SHIFT                      &kp BACKSPACE  &mo 0   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        hands_down {
            bindings = <
&mt TILDE GRAVE         &mt EXCLAMATION NUMBER_1  &mt AT_SIGN NUMBER_2    &mt HASH NUMBER_3  &mt DOLLAR NUMBER_4  &mt PERCENT N5                                                                             &mt LCTRL NUMBER_6      &mt AMPERSAND N7               &mt ASTERISK N8      &mt LEFT_PARENTHESIS N9  &mt RIGHT_PARENTHESIS N0  &mt PLUS EQUAL
&mt LEFT_CONTROL GRAVE  &mt LEFT_BRACE W          &mt ASTERISK F          &mt PERCENT M      &mt SLASH P          &mt PLUS V                                                                                 &mt HASH SQT            &mt EXCLAMATION DOUBLE_QUOTES  &mt COLON SEMICOLON  &mt UNDERSCORE MINUS     &mt RIGHT_BRACE SLASH     &mt BACKSLASH Z
&mt LEFT_ALT TILDE      &mt SEMICOLON R           &mt LEFT_PARENTHESIS S  &mt EQUAL N        &mt COMMA T          &mt LESS_THAN B                                                                            &mt GREATER_THAN COMMA  &mt AMPERSAND A                &mt QUESTION E       &mt RIGHT_PARENTHESIS I  &mt MINUS H               &mt RIGHT_CONTROL J
&mt GLOBE TAB           &kp X                     &mt K C                 &kp L              &kp D                &kp G            &mt LEFT_PARENTHESIS LEFT_BRACKET    &mt RIGHT_PARENTHESIS RIGHT_BRACKET  &mt COMMA PERIOD        &mt Q U                        &mt MINUS O          &mt Y SLASH              &kp K                     &kp CAPSLOCK
                                                                          &kp LGUI           &mo 4                &kp RET          &kp SPACE                            &kp RSHFT                            &kp BACKSPACE           &mo 5                          &kp RGUI
            >;
        };

        x1.en.ergodox {
            bindings = <
&mt TILDE GRAVE  &mt EXCLAMATION NUMBER_1  &mt AT_SIGN NUMBER_2    &mt HASH NUMBER_3  &mt N4 NUMBER_4  &mt PERCENT N5                                                                             &mt LCTRL NUMBER_6  &mt AMPERSAND N7            &mt ASTERISK N8    &mt LEFT_PARENTHESIS N9  &mt RIGHT_PARENTHESIS N0  &mt PLUS EQUAL
&mt DOLLAR Z     &mt GREATER_THAN Q        &mt ASTERISK P          &mt PERCENT L      &mt K C          &mt PLUS F                                                                                 &mt HASH SQT        &mt QUESTION DOUBLE_QUOTES  &mt COLON O        &mt UNDERSCORE Y         &mt SLASH K               &mt PIPE BACKSLASH
&mt TILDE V      &mt SEMICOLON R           &mt LEFT_PARENTHESIS N  &mt EQUAL F        &mt COMMA S      &mt LESS_THAN D                                                                            &mt Q U             &mt AMPERSAND A             &mt QUESTION E     &mt RIGHT_PARENTHESIS I  &mt MINUS H               &kp RIGHT_CONTROL
&mt GLOBE TAB    &mt NUMBER_1 X            &mt NUMBER_2 B          &mt NUMBER_3 M     &mt NUMBER_4 G   &mt N5 W         &mt LEFT_PARENTHESIS LEFT_BRACKET    &mt RIGHT_PARENTHESIS RIGHT_BRACKET  &mt NUMBER_6 COMMA  &mt N7 PERIOD               &mt N8 MINUS       &mt N9 SLASH             &mt N0 J                  &kp CAPS
                                                                   &kp LEFT_COMMAND   &mo 4            &mo 0            &kp SPACE                            &kp RSHFT                            &kp BSPC            &mt RIGHT_ALT RET           &kp RIGHT_COMMAND
            >;
        };

        symbols {
            bindings = <
&kp ESCAPE  &tog 0           &trans       &trans    &trans      &trans                                                      &trans     &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp BACKSLASH   &kp PIPE        &trans
&trans      &trans           &trans       &trans    &trans      &trans                                                      &kp PLUS   &kp LESS_THAN   &kp GREATER_THAN  &kp UNDERSCORE  &kp QUESTION    &kp EXCLAMATION
&trans      &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                                                 &kp CARET  &kp AMPERSAND   &kp ASTERISK      &trans          &kp UP_ARROW    &trans
&trans      &trans           &trans       &trans    &trans      &trans       &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp EQUAL  &kp TILDE       &kp GRAVE         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
                                          &trans    &trans      &trans       &trans                  &trans                 &trans     &trans          &trans
            >;
        };

        system {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &tog 1       &tog 0          &none           &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC                          &kp C_VOL_DN   &kp C_VOLUME_UP  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT   &none
&trans  &none        &none           &mmv MOVE_UP    &none                 &none                                         &kp K_MUTE     &none            &kp UP      &none             &none        &trans
&none   &none        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT       &msc SCRL_UP                                  &kp PAGE_UP    &kp LEFT         &kp DOWN    &kp RIGHT         &none        &none
&none   &bootloader  &none           &none           &none                 &msc SCRL_DOWN        &trans       &trans     &kp PAGE_DOWN  &none            &none       &none             &bootloader  &trans
                                     &trans          &trans                &trans                &mkp LCLK    &mkp RCLK  &mkp MCLK      &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        hands_down_lower {
            bindings = <
&kp ESCAPE  &tog 0           &trans       &trans    &trans      &trans                                                      &trans     &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp BACKSLASH   &kp PIPE        &trans
&trans      &trans           &trans       &trans    &trans      &trans                                                      &kp PLUS   &kp LESS_THAN   &kp GREATER_THAN  &kp UNDERSCORE  &kp QUESTION    &kp EXCLAMATION
&trans      &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                                                 &kp CARET  &kp AMPERSAND   &kp ASTERISK      &trans          &kp UP_ARROW    &trans
&trans      &trans           &trans       &trans    &trans      &trans       &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp EQUAL  &kp TILDE       &kp GRAVE         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
                                          &trans    &trans      &trans       &trans                  &trans                 &trans     &trans          &trans
            >;
        };

        arrows_selection {
            bindings = <
&none  &none           &tog 0          &none             &none           &none                      &none      &none           &none              &tog 0          &none           &none
&none  &kp ESCAPE      &kp UP_ARROW    &mkp LCLK         &kp BACKSPACE   &none                      &none      &kp BACKSPACE   &mkp LCLK          &kp UP_ARROW    &kp ESCAPE      &none
&none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW   &mkp RCLK       &none                      &none      &mkp RCLK       &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT       &none
&mo 6  &kp LEFT_SHIFT  &none           &kp RIGHT_SHIFT   &kp TAB         &none      &none    &none  &none      &kp TAB         &kp RIGHT_SHIFT    &none           &kp LEFT_SHIFT  &mo 6
                                       &sk LEFT_COMMAND  &sk LEFT_SHIFT  &kp SPACE  &mo 0    &mo 0  &kp SPACE  &sk LEFT_SHIFT  &sk RIGHT_COMMAND
            >;
        };
    };
};
