        symbols {
            bindings = <
&kp ESCAPE              &kp F1          &kp F2                &kp F3            &kp F4        &kp F5                                                             &kp F6            &kp F7             &kp F8             &kp F9                 &kp F10          &tog 15
&kp GRAVE               &kp LEFT_BRACE  &kp ASTERISK          &kp PERCENT       &kp SLASH     &kp PLUS                                                           &kp AMPERSAND     &kp QUESTION       &kp COLON          &kp UNDERSCORE         &kp RIGHT_BRACE  &mt NON_US_BACKSLASH PIPE
&mt LEFT_CONTROL TILDE  &kp SEMICOLON   &kp LEFT_PARENTHESIS  &kp EQUAL         &kp COMMA     &kp LESS_THAN                                                      &kp GREATER_THAN  &kp PERIOD         &kp DOUBLE_QUOTES  &kp RIGHT_PARENTHESIS  &kp MINUS        &kp HASH
&kp TAB                 &mt DOLLAR N1   &kp N2                &kp N3            &mt HASH N4   &mt EXCLAMATION N5  &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp N6            &kp N7             &kp N8             &kp N9                 &kp N0           &kp CAPSLOCK
