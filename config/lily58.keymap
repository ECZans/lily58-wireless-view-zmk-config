#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Workman {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Wkmn";
            bindings = <
&kp ESC                 &mt EXCLAMATION NUMBER_1  &mt AT_SIGN NUMBER_2  &mt HASH NUMBER_3  &mt DOLLAR NUMBER_4  &mt PERCENT NUMBER_5                                                                            &mt LCTRL NUMBER_6  &mt AMPERSAND NUMBER_7  &mt ASTERISK NUMBER_8  &mt LEFT_PARENTHESIS NUMBER_9  &mt RIGHT_PARENTHESIS NUMBER_0  &mt PLUS EQUAL
&mt LEFT_CONTROL GRAVE  &kp Q                     &kp D                 &kp R              &kp W                &kp B                                                                                           &kp J               &kp F                   &kp U                  &kp P                          &mt UNDERSCORE MINUS            &mt AMPERSAND HASH
&mt LEFT_ALT SQT        &kp A                     &kp S                 &kp H              &kp T                &kp G                                                                                           &kp Y               &kp N                   &kp E                  &kp O                          &kp I                           &mt COLON SEMICOLON
&mt GLOBE TAB           &kp Z                     &kp X                 &kp M              &kp C                &kp V                 &mt LEFT_PARENTHESIS LEFT_BRACKET    &mt RIGHT_PARENTHESIS RIGHT_BRACKET  &kp K               &kp L                   &mt LESS_THAN COMMA    &mt GREATER_THAN PERIOD        &mt QUESTION SLASH              &kp CAPS
                                                                        &kp LEFT_COMMAND   &mo 14               &kp RET               &kp SPACE                            &kp RIGHT_SHIFT                      &kp BACKSPACE       &mo 15                  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Heyyou {
            display-name = "Heyou";
            bindings = <
&kp ESC                 &mt EXCLAMATION NUMBER_1  &mt AT_SIGN NUMBER_2  &mt HASH NUMBER_3  &mt DOLLAR NUMBER_4  &mt PERCENT NUMBER_5                                                                            &mt LCTRL NUMBER_6  &mt AMPERSAND NUMBER_7  &mt ASTERISK NUMBER_8  &mt LEFT_PARENTHESIS NUMBER_9  &mt RIGHT_PARENTHESIS NUMBER_0  &mt PLUS EQUAL
&mt LEFT_CONTROL GRAVE  &kp B                     &kp C                 &kp L              &kp K                &kp Q                                                                                           &kp Z               &kp U                   &kp O                  &kp Y                          &kp F                           &mt AMPERSAND HASH
&mt LEFT_ALT SQT        &kp N                     &kp S                 &kp R              &kp T                &kp M                                                                                           &kp COMMA           &kp A                   &kp E                  &kp I                          &kp H                           &kp FSLH
&mt GLOBE TAB           &kp P                     &kp V                 &kp W              &kp D                &kp G                 &mt LEFT_PARENTHESIS LEFT_BRACKET    &mt RIGHT_PARENTHESIS RIGHT_BRACKET  &kp SQT             &kp DOT                 &kp SEMI               &kp X                          &kp J                           &kp CAPS
                                                                        &kp LEFT_COMMAND   &mo 14               &kp RET               &kp SPACE                            &kp RIGHT_SHIFT                      &kp BACKSPACE       &mo 15                  &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

