#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC       &kp N1  &kp N2  &kp N3            &kp N4  &kp N5                                                                                &kp N6         &kp N7  &kp N8     &kp N9   &kp N0     &kp GRAVE
&kp LEFT_ALT  &kp Q   &kp D   &kp R             &kp W   &kp B                                                                                 &kp J          &kp F   &kp U      &kp P    &kp TAB    &kp RIGHT_CONTROL
&kp SQT       &kp A   &kp S   &kp H             &kp T   &kp G                                                                                 &kp Y          &kp N   &kp E      &kp O    &kp I      &kp SEMICOLON
&kp MINUS     &kp Z   &kp X   &kp M             &kp C   &kp V       &mt LEFT_PARENTHESIS LEFT_BRACKET    &mt RIGHT_PARENTHESIS RIGHT_BRACKET  &kp K          &kp L   &kp COMMA  &kp DOT  &kp SLASH  &mo 2
                              &kp LEFT_COMMAND  &mo 2   &kp RETURN  &kp SPACE                            &kp RIGHT_SHIFT                      &kp BACKSPACE  &mo 1   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&kp F1  &kp F2         &kp F3        &kp F4        &kp F5        &kp F6                                                                                    &kp F7         &kp F8         &kp F9        &kp F10   &kp F11   &kp F12
&trans  &kp NUMBER_1   &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                                                                                    &kp NUMBER_6   &kp N7         &kp N8        &kp N9    &kp N0    &trans
&trans  &kp EXCL       &kp AT        &kp HASH      &kp DOLLAR    &kp PRCNT                                                                                 &kp CARET      &kp AMPERSAND  &kp ASTERISK  &kp LPAR  &kp RPAR  &trans
&trans  &kp BACKSLASH  &kp GRAVE     &kp MINUS     &kp EQUAL     &kp UNDERSCORE  &mt LEFT_BRACKET LEFT_PARENTHESIS    &mt RIGHT_BRACKET RIGHT_PARENTHESIS  &kp SEMICOLON  &kp SLASH      &trans        &trans    &trans    &trans
                                     &trans        &trans        &trans          &trans                               &trans                               &trans         &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &tog 3       &tog 5          &none           &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC                          &kp C_VOL_DN   &kp C_VOLUME_UP  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT   &none
&trans  &none        &none           &mmv MOVE_UP    &none                 &none                                         &kp K_MUTE     &none            &kp UP      &none             &none        &trans
&none   &none        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT       &msc SCRL_UP                                  &kp PAGE_UP    &kp LEFT         &kp DOWN    &kp RIGHT         &none        &none
&none   &bootloader  &none           &none           &none                 &msc SCRL_DOWN        &trans       &trans     &kp PAGE_DOWN  &none            &none       &none             &bootloader  &trans
                                     &trans          &trans                &trans                &mkp LCLK    &mkp RCLK  &mkp MCLK      &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        hands_down {
            bindings = <
&kp GRAVE         &kp N1  &kp N2  &kp N3    &kp N4     &kp N5                           &kp N6               &kp N7                      &kp N8               &kp N9                &kp N0          &kp EQUAL
&kp LEFT_CONTROL  &kp W   &kp F   &kp M     &kp P      &kp V                            &mt COLON SEMICOLON  &mt QUESTION DOUBLE_QUOTES  &mt EXCLAMATION SQT  &mt UNDERSCORE MINUS  &mt PIPE SLASH  &kp Z
&kp LEFT_ALT      &kp R   &kp S   &kp N     &kp T      &kp B                            &mt AMPERSAND COMMA  &kp A                       &kp E                &kp I                 &kp H           &kp J
&kp GLOBE         &kp X   &kp C   &kp L     &kp D      &kp G    &kp LBKT     &kp RBKT   &mt HASH PERIOD      &mt Q U                     &kp O                &kp Y                 &kp K           &kp CAPSLOCK
                                  &kp LGUI  &lt 4 TAB  &kp RET  &kp SPACE    &kp RSHFT  &kp BACKSPACE        &mo 4                       &kp RGUI
            >;
        };

        hands_down_1 {
            bindings = <
&kp ESCAPE  &tog 0           &trans       &trans    &trans      &trans                                                      &trans     &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp BACKSLASH   &kp PIPE        &trans
&trans      &trans           &trans       &trans    &trans      &trans                                                      &kp PLUS   &kp LESS_THAN   &kp GREATER_THAN  &kp UNDERSCORE  &kp QUESTION    &kp EXCLAMATION
&trans      &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                                                 &kp CARET  &kp AMPERSAND   &kp ASTERISK      &trans          &kp UP_ARROW    &trans
&trans      &trans           &trans       &trans    &trans      &trans       &kp LEFT_PARENTHESIS    &kp RIGHT_PARENTHESIS  &kp EQUAL  &kp TILDE       &kp GRAVE         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
                                          &trans    &trans      &trans       &trans                  &trans                 &trans     &trans          &trans
            >;
        };

        LH_workman {
            display-name = "Base";
            bindings = <
&kp BACKSPACE  &kp N1  &kp N2  &kp N3            &kp N4          &kp N5                                                                                             &kp N5                  &kp N4           &kp N3             &kp N2  &kp N1  &kp BACKSPACE
&kp COMMA      &kp Q   &kp D   &kp R             &kp W           &kp B                                                                                              &kp B                   &kp W            &kp R              &kp D   &kp Q   &kp COMMA
&kp PERIOD     &kp A   &kp S   &kp H             &kp T           &kp G                                                                                              &kp G                   &kp T            &kp H              &kp S   &kp A   &kp PERIOD
&kp MINUS      &kp Z   &kp X   &kp M             &kp C           &kp V                    &mt LEFT_PARENTHESIS LEFT_BRACKET    &mt RIGHT_PARENTHESIS RIGHT_BRACKET  &kp V                   &kp C            &kp M              &kp X   &kp Z   &kp MINUS
                               &sk LEFT_COMMAND  &sk LEFT_SHIFT  &mt RIGHT_CONTROL SPACE  &mo 6                                &mo 6                                &mt LEFT_CONTROL SPACE  &sk RIGHT_SHIFT  &sk RIGHT_COMMAND
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        LH_workman_1 {
            bindings = <
&kp GRAVE  &kp N6           &kp N7   &kp N8             &kp N9          &kp N0                                                                               &kp N0     &kp N9           &kp N8             &kp N7   &kp N6           &kp GRAVE
&sk LCTRL  &kp EXCLAMATION  &kp P    &kp U              &kp F           &kp J                                                                                &kp J      &kp F            &kp U              &kp P    &kp EXCLAMATION  &sk RCTRL
&kp SEMI   &kp I            &kp O    &kp E              &kp N           &kp Y                                                                                &kp Y      &kp N            &kp E              &kp O    &kp I            &kp SEMI
&mo 7      &kp FSLH         &kp SQT  &kp DOUBLE_QUOTES  &kp L           &kp K      &mt LEFT_PARENTHESIS LEFT_BRACKET    &mt RIGHT_PARENTHESIS RIGHT_BRACKET  &kp K      &kp L            &kp DOUBLE_QUOTES  &kp SQT  &kp FSLH         &mo 7
                                     &sk LEFT_COMMAND   &sk LEFT_SHIFT  &kp SPACE  &mo 6                                &mo 6                                &kp SPACE  &sk RIGHT_SHIFT  &sk RIGHT_COMMAND
            >;
        };

        lh_workman_2 {
            bindings = <
&none  &none           &tog 0          &none             &none           &none                      &none      &none           &none              &tog 0          &none           &none
&none  &kp ESCAPE      &kp UP_ARROW    &mkp LCLK         &kp BACKSPACE   &none                      &none      &kp BACKSPACE   &mkp LCLK          &kp UP_ARROW    &kp ESCAPE      &none
&none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW   &mkp RCLK       &none                      &none      &mkp RCLK       &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT       &none
&mo 7  &kp LEFT_SHIFT  &none           &kp RIGHT_SHIFT   &kp TAB         &none      &none    &none  &none      &kp TAB         &kp RIGHT_SHIFT    &none           &kp LEFT_SHIFT  &mo 7
                                       &sk LEFT_COMMAND  &sk LEFT_SHIFT  &kp SPACE  &mo 6    &mo 6  &kp SPACE  &sk LEFT_SHIFT  &sk RIGHT_COMMAND
            >;
        };

        hands_down_neu_tweak {
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3    &kp N4   &kp N5                           &kp N6     &kp N7    &kp N8    &kp N9             &kp N0            &kp RIGHT
&kp ESC    &kp W   &kp F   &kp M     &kp P    &kp V                            &kp SEMI   &kp DOT   &kp Q     &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp RIGHT_CONTROL
&kp Z      &kp R   &kp S   &kp N     &kp T    &kp B                            &kp COMMA  &kp A     &kp E     &kp I              &kp O             &kp J
&kp LALT   &kp X   &kp C   &kp L     &kp D    &kp G    &kp LBKT     &kp RBKT   &kp MINUS  &kp U     &kp Y     &kp H              &kp K             &kp LEFT_ARROW
                           &kp LGUI  &kp TAB  &kp RET  &kp SPACE    &kp RSHFT  &mo 4      &kp BSPC  &kp RGUI
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
